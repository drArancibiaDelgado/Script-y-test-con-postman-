    {
      "name": "HU04 - Consultar auto y votos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();\r\n\r\n// Code is 200\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Contains string\r\npm.test(\"Response body contains Lancia\", function () {\r\n    pm.expect(pm.response.text()).to.include(\"Lancia\");\r\n});\r\n\r\n\r\n// JSON value check\r\npm.test(\"JSON contains votes\", function () {\r\n    pm.expect(jsonData.votes).to.exist;\r\n});\r\n\r\n// Is equal to a string\r\npm.test(\"Make is equal to Lancia\", function () {\r\n    pm.expect(jsonData.make).to.eql(\"Lancia\");\r\n});\r\n\r\n// Verifica específicamente HU-04\r\npm.test(\"HU-04 comment was registered\", function () {\r\n    const found = jsonData.comments.some(function (comment) {\r\n        return comment.text === \"Prueba automatizada HU-04\";\r\n    });\r\n\r\n    pm.expect(found).to.be.true;\r\n});\r\n\r\n// Content-Type header check\r\npm.test(\"Content-Type header check\", function () {\r\n    pm.expect(pm.response.headers.get(\"Content-Type\"))\r\n        .to.include(\"application/json\");\r\n});"
            ]
          }
        }
